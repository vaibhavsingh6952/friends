---
interface Props {
  value: string | number;
  label: string;
}
const { value, label } = Astro.props;
---
<div class="kpi-tile">
  <div class="kpi-value">{value}</div>
  <div class="kpi-label">{label}</div>
</div>
<style>
  .kpi-tile {
    background: rgba(0, 0, 0, 0.12);
    border: 2px solid #e9dcd3;
    border-radius: 2px;
    padding: 12px 16px;
    text-align: center;
    min-width: 80px;
  }
  .kpi-value {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 1.5rem;
    font-weight: 700;
    color: #f4eae1;
    line-height: 1.2;
  }
  .kpi-label {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.7rem;
    font-weight: 400;
    color: #c9a9a6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
  }
</style>
---
interface Props {
  repos: import("@friends/api/lib/domain/types").TopRepo[];
}
const { repos } = Astro.props;
const maxStars = repos.length > 0 ? repos[0].stars : 1;
---
<div class="panel">
  <h2 class="panel-title">Top starred repos</h2>
  <ul class="repo-list">
    {repos.map((r) => (
      <li class="repo-row">
        <a href={r.url} target="_blank" rel="noopener noreferrer" class="repo-link">
          <img class="avatar" src={`https://github.com/${r.owner}.png?size=32`} alt={r.owner} width="32" height="32" loading="lazy" />
          <div class="repo-info">
            <div class="repo-name">{r.owner}/{r.name}</div>
            {r.language && (
              <div class="repo-meta">
                <span class="lang-dot" style={`background: ${r.color ?? "#cccccc"};`}></span>
                <span class="repo-language">{r.language}</span>
              </div>
            )}
          </div>
        </a>
        <div class="repo-stats">
          <span class="repo-stars">★ {formatNumber(r.stars)}</span>
          <div class="repo-bar-container">
            <div class="repo-bar" style={`width: ${(r.stars / maxStars) * 100}%;`}></div>
          </div>
        </div>
      </li>
    ))}
    {repos.length === 0 && <li class="empty">No repository data</li>}
  </ul>
</div>
<script>
  import { formatNumber } from "../lib/format.js";
</script>
<style>
  .panel {
    background: rgba(0, 0, 0, 0.12);
    border: 2px solid #e9dcd3;
    border-radius: 2px;
    padding: 16px;
  }
  .panel-title {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.85rem;
    font-weight: 700;
    color: #f4eae1;
    text-align: center;
    margin: 0 0 12px;
    letter-spacing: 0.05em;
  }
  .repo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .repo-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(233, 220, 211, 0.15);
  }
  .repo-row:last-child { border-bottom: none; }
  .repo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex: 1;
    min-width: 0;
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #e9dcd3;
    flex-shrink: 0;
  }
  .repo-info { min-width: 0; }
  .repo-name {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.8rem;
    font-weight: 600;
    color: #f4eae1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .repo-meta { display: flex; align-items: center; gap: 6px; margin-top: 2px; }
  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    flex-shrink: 0;
  }
  .repo-language {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.65rem;
    color: #c9a9a6;
  }
  .repo-stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
    min-width: 100px;
  }
  .repo-stars {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.75rem;
    font-weight: 600;
    color: #f4eae1;
  }
  .repo-bar-container {
    width: 100%;
    height: 4px;
    background: rgba(201, 169, 166, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }
  .repo-bar {
    height: 100%;
    background: #e9dcd3;
    border-radius: 2px;
    transition: width 0.3s ease;
  }
  .empty {
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.75rem;
    color: #c9a9a6;
    text-align: center;
    padding: 20px;
  }
</style>
---
interface Props {
  committers: import("@friends/api/lib/domain/types").TopCommitter[];
}
const { committers } = Astro.props;
---
<div class="panel hero-panel">
  <div class="hero-avatars" role="img" aria-label="Top committers">
    {committers.map((c, i) => {
      const size = [140, 110, 96, 84, 76][i] ?? 70;
      const jitterX = deterministicJitter(c.login, 15);
      const jitterY = deterministicJitter(c.login + "y", 10);
      const zIndex = 6 - i;
      return (
        <a
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-avatar"
          style={`
            width: ${size}px;
            height: ${size}px;
            left: ${50 + jitterX}%;
            top: ${40 + jitterY}%;
            z-index: ${zIndex};
          `}
          aria-label={c.name ?? c.login}
        >
          <img src={c.avatarUrl} alt="" width={size} height={size} loading="lazy" />
          <span class="rank-badge">{i + 1}</span>
          <span class="commit-pill">{formatNumber(c.commits30d)} commits</span>
        </a>
      )
    })}
  </div>
  <div class="friends-wordmark">Friends</div>
  <ol class="sr-only" aria-label="Top committers ranking">
    {committers.map((c, i) => (
      <li>{i + 1}. {c.name ?? c.login} — {c.commits30d} commits</li>
    ))}
  </ol>
</div>
<script>
  import { formatNumber, deterministicJitter } from "../lib/format.js";
</script>
<style>
  .hero-panel {
    background: rgba(0, 0, 0, 0.12);
    border: 2px solid #e9dcd3;
    border-radius: 2px;
    padding: 16px;
    position: relative;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-avatars {
    position: relative;
    width: 100%;
    height: 240px;
    flex-shrink: 0;
  }
  .hero-avatar {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 3px solid #f4eae1;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-avatar:hover,
  .hero-avatar:focus {
    transform: translate(-50%, -50%) scale(1.05);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    z-index: 10 !important;
    outline: none;
  }
  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .rank-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #6b2d35;
    border: 2px solid #f4eae1;
    color: #f4eae1;
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.65rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .commit-pill {
    background: rgba(0, 0, 0, 0.7);
    color: #f4eae1;
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.6rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
    margin-bottom: 4px;
  }
  .friends-wordmark {
    font-family: "Fredoka", "Trebuchet MS", "Segoe UI", system-ui;
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: #f4eae1;
    letter-spacing: 0.1em;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
    margin-top: 8px;
    line-height: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
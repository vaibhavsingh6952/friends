---
interface Props {
  onSubmit: (username: string) => void;
  defaultValue?: string;
}
const { onSubmit, defaultValue } = Astro.props;
---
<form class="search-form" data-search-form>
  <label for="username" class="sr-only">GitHub username</label>
  <input
    type="text"
    id="username"
    name="username"
    placeholder="GitHub username"
    value={defaultValue ?? ""}
    autocomplete="username"
    maxlength="39"
    required
  />
  <button type="submit">Go</button>
</form>
<style>
  .search-form {
    display: flex;
    gap: 8px;
    max-width: 400px;
    margin: 0 auto;
  }
  .search-form input {
    flex: 1;
    padding: 10px 14px;
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.95rem;
    background: rgba(0, 0, 0, 0.2);
    border: 2px solid #e9dcd3;
    border-radius: 2px;
    color: #f4eae1;
    outline: none;
  }
  .search-form input::placeholder { color: #c9a9a6; }
  .search-form input:focus { border-color: #6ee7a0; }
  .search-form button {
    padding: 10px 20px;
    font-family: "Trebuchet MS", "Segoe UI", system-ui;
    font-size: 0.95rem;
    font-weight: 700;
    background: #6b2d35;
    border: 2px solid #e9dcd3;
    border-radius: 2px;
    color: #f4eae1;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .search-form button:hover { background: #8b3d45; }
  .search-form button:focus { outline: 2px solid #6ee7a0; outline-offset: 2px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>